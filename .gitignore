# ---------------------------------------------------------------------------
# Dataset + model artefacts: tracked by DVC, never by Git.
# Only the small .dvc pointers and the committed CI sample index live here.
# ---------------------------------------------------------------------------
data/*/**/zip
data/raw/*.zip
data/raw/sample.zip
data/interim/*
!data/interim/.gitkeep
!data/interim/.gitignore
data/processed/*
!data/processed/.gitkeep
!data/processed/.gitignore
models/*
!models/.gitkeep
!models/.gitignore
.dvc/cache/
.dvc/tmp/
mlruns/
*.ckpt
*.pth
*.pt
*.h5
*.joblib
*.pkl

# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.dvc/config.local
.dvc/config.local.*
secrets.yml
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
venv.bak/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter
.ipynb_checkpoints
profile_default/
ipython_config.py
# Notebook outputs are stripped by nbstripout; keep the .ipynb files themselves.
*.ipynb_checkpoints

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache
nosetests.xml

# type checkers and linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Cython
cython_debug/

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# dbt / misc
target/
manifest.json
dbt_packages/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env.local
.env.*.local
!.env.example