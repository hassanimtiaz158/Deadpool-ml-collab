# Paths DVC should never try to track.
# Learn more: https://dvc.org/doc/user-guide/dvcignore

# Caches and locks are managed by DVC itself.
.dvc/cache/
.dvc/tmp/
.dvc/.gitignore
.dvc/config.local

# Git metadata
.git/
.github/

# Environments and local state
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Build/tooling artefacts
.ruff_cache/
.hypothesis/
*.egg-info/
build/
dist/

# DVC's own report HTML and log files
.dvc/reports/
dvc.log

# NOTE: data/interim/ and data/processed/ are deliberately *not* ignored here.
# They are declared as stage outputs in dvc.yaml, and DVC refuses to run a stage
# whose outputs its own .dvcignore excludes. Re-discovery by `dvc add` is
# already prevented because those paths are owned by a stage.